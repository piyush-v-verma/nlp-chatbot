# X-Pilot Secure Environment Variables Example
# Duplicate this file to '.env' and fill in your values. Do NOT commit the '.env' file to Git!

# Flask application configurations
FLASK_SECRET_KEY=generate_your_own_secret_key_here
# python -c "import secrets; print(secrets.token_hex(32))" run this command to get secret key
FLASK_ENV=development

# Gemini API configuration
# Ensure the hardcoded key previously in app.py is rotated/revoked.
GEMINI_API_KEY=your_gemini_api_key_here
